# jev.nvim reads these from the environment. Copy to .env and source it, or export them
# from your shell profile. Nothing here is needed to run the tests.

# Your TypeSafe key. Required to reach the real API.
TYPESAFE_API_KEY=

# Point the plugin somewhere other than https://api.typesafe.ai: a local gateway shim,
# a recording proxy, or the fake in tests/. Optional.
JEV_BASE_URL=

# Model id. Optional, defaults to jev-1.13.0. Pinned rather than jev-latest because the
# published threshold was measured against one model.
JEV_MODEL=

# Request tuning, all optional. The defaults are 4, 3 and 20000.
JEV_CONCURRENCY=
JEV_ATTEMPTS=
JEV_TIMEOUT_MS=
